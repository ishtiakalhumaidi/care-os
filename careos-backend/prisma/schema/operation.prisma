model Attendance {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(PENDING_CHECKIN)

  checkInRequestedAt DateTime?
  checkInRequestedBy String?
  checkInTime        DateTime?
  checkedInBy        String?

  checkOutRequestedAt  DateTime?
  checkOutRequestedBy  String?
  checkOutReason       String?
  checkOutTime         DateTime?
  checkedOutBy         String?
  pickedUpByGuardianId String?
  createdAt            DateTime  @default(now())

  syncedAt DateTime @default(now())

  @@index([childId, status])
}

model TimelineEvent {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  eventType   String
  description String?
  loggedBy    String
  loggedAt    DateTime @default(now())
}
